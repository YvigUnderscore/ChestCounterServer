# Copy to .env (optional: everything has a default) then: docker compose up -d

# Keys: only read on the FIRST start, then kept in data/keys.json.
# Leave GROUP_KEY empty to get a random one (shown by: docker compose exec chests python -m app.admin show).
# To change them later: docker compose exec chests python -m app.admin rotate group   (or: rotate view / clear view)
GROUP_KEY=
# Optional key to READ the site: share it as https://host/?k=VIEW_KEY. Empty = whoever has the address can read.
VIEW_KEY=

GROUP_NAME=Coffres du serveur
# Address the friends use (e.g. https://coffres.example.org): links shown by the clients and the admin command.
PUBLIC_URL=
PORT=8080
TZ=Europe/Paris
# Newer treasure hunt data, fetched every 2 hours (empty = only the copy built into the image).
# CONTENT_URL=https://raw.githubusercontent.com/LED-N/Fortnite-ChestCounter/main/content/content.json
